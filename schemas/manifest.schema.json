{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "kind", "sourceRepository", "sourceSha", "fileCount", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"enum": ["import", "evidence"]},
    "sourceRepository": {"const": "AvaloNero/Spherewright"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fileCount": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["sourcePath", "size", "sha256"],
        "properties": {
          "sourcePath": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "destinationPath": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "storage": {"enum": ["git", "protected-local"]},
          "redacted": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "import"}}}, "then": {"required": ["planSha256", "totalSourceBytes", "gitArchiveCount", "protectedLocalCount"], "properties": {"files": {"items": {"required": ["sourceRepository", "sourceSha", "destinationPath", "normalizedPath", "storage"]}}}}},
    {"if": {"properties": {"kind": {"const": "evidence"}}}, "then": {"required": ["importManifest", "importManifestSha256", "linkManifest", "linkManifestSha256"], "properties": {"files": {"items": {"required": ["path", "redacted"]}}}}}
  ]
}
