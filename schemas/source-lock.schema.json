{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "status", "scenario", "spherewright", "native", "packages", "acceptance", "evidenceSource"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "status": {"enum": ["development", "provisional", "tagged"]},
    "scenario": {"type": "string", "minLength": 1},
    "spherewright": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "submodulePath", "sourceSha", "releaseTag", "productVersion"],
      "properties": {
        "repository": {"enum": ["Arcueid77/Spherewright", "AvaloNero/Spherewright"]},
        "submodulePath": {"const": "deps/Spherewright"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "releaseTag": {"type": ["string", "null"]},
        "productVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "native": {"$ref": "#/definitions/native"},
    "packages": {
      "type": "object", "additionalProperties": false, "required": ["manual", "thunderstore"],
      "properties": {
        "manual": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/package"}]},
        "thunderstore": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/package"}]}
      }
    },
    "development": {
      "type": "object", "additionalProperties": false, "required": ["targetVersion"],
      "properties": {"targetVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "installed": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSha", "productVersion", "releaseTag", "native", "packages", "evidence", "verification", "runtimeState"],
      "properties": {
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "productVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "releaseTag": {"type": ["string", "null"]},
        "native": {"$ref": "#/definitions/native"},
        "packages": {
          "type": "object", "additionalProperties": false, "required": ["manual", "thunderstore"],
          "properties": {
            "manual": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/package"}]},
            "thunderstore": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/package"}]}
          }
        },
        "developmentArtifact": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "manifestSha256", "pluginFiles", "mcpFiles"],
          "properties": {
            "kind": {"const": "plugin_mcp_directory"},
            "manifestSha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
            "pluginFiles": {"type": "integer", "minimum": 4},
            "mcpFiles": {"type": "integer", "minimum": 1}
          }
        },
        "evidence": {"type": "string", "minLength": 1},
        "verification": {"enum": ["historical_record", "disk_verified"]},
        "runtimeState": {"enum": ["not_observed", "not_running", "running_unverified", "running_verified"]}
      },
      "allOf": [{
        "if": {"properties": {"packages": {"properties": {"manual": {"type": "null"}, "thunderstore": {"type": "null"}}}}},
        "then": {"required": ["developmentArtifact"], "properties": {"releaseTag": {"type": "null"}}},
        "else": {
          "not": {"required": ["developmentArtifact"]},
          "properties": {"packages": {"properties": {"manual": {"$ref": "#/definitions/package"}, "thunderstore": {"$ref": "#/definitions/package"}}}}
        }
      }]
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["spec", "evidenceManifest", "evidenceManifestSha256"],
      "properties": {
        "spec": {"type": "string"},
        "evidenceManifest": {"type": "string"},
        "evidenceManifestSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "scope": {"const": "historical_reference"},
        "sourceLock": {"type": "string", "minLength": 1},
        "sourceLockSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      },
      "oneOf": [
        {"not": {"anyOf": [{"required": ["scope"]}, {"required": ["sourceLock"]}, {"required": ["sourceLockSha256"]}]}},
        {"required": ["scope", "sourceLock", "sourceLockSha256"]}
      ]
    },
    "evidenceSource": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "sourceSha"],
      "properties": {"repository": {"const": "AvaloNero/Spherewright"}, "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}},
      "then": {
        "properties": {"status": {"enum": ["provisional", "tagged"]}},
        "not": {"anyOf": [{"required": ["development"]}, {"required": ["installed"]}]}
      },
      "else": {"required": ["installed"]}
    },
    {
      "if": {"properties": {"status": {"const": "development"}}},
      "then": {
        "required": ["development"],
        "properties": {
          "spherewright": {"properties": {"releaseTag": {"type": "null"}}},
          "packages": {"properties": {"manual": {"type": "null"}, "thunderstore": {"type": "null"}}},
          "acceptance": {"required": ["scope", "sourceLock", "sourceLockSha256"]}
        }
      },
      "else": {"properties": {"packages": {"properties": {"manual": {"$ref": "#/definitions/package"}, "thunderstore": {"$ref": "#/definitions/package"}}}}}
    }
  ],
  "definitions": {
    "native": {
      "type": "object", "additionalProperties": false, "required": ["version", "assemblySha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "assemblySha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false, "required": ["file", "sha256", "size"],
      "properties": {"file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.zip$"}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "size": {"type": "integer", "minimum": 1}}
    }
  }
}
